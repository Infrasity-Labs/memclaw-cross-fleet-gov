# MemClaw (local Docker — no API key required)
MEMCLAW_API_URL=http://localhost:8000
MEMCLAW_API_KEY=
MEMCLAW_TENANT_ID=YOUR_TENANT_ID
MEMCLAW_AUTO_WRITE_TURNS=false

# LLM provider (OpenAI-compatible)
LLM_GATEWAY_API_KEY=YOUR_LLM_GATEWAY_API_KEY
LLM_GATEWAY_MODEL=YOUR_LLM_GATEWAY_MODEL
LLM_GATEWAY_BASE_URL=YOUR_LLM_GATEWAY_BASE_URL
