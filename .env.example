# MemClaw (local Docker — no API key required for local deploy)
MEMCLAW_API_URL=http://localhost:8000
MEMCLAW_API_KEY=
MEMCLAW_TENANT_ID=default
MEMCLAW_AUTO_WRITE_TURNS=false

# LLM provider (OpenAI-compatible)
# Option A — LLM gateway:
LLM_GATEWAY_API_KEY=your-llm-gateway-api-key
LLM_GATEWAY_BASE_URL=https://your-gateway.example.com/v1
LLM_GATEWAY_MODEL=your-model-id

# Option B — Ollama (fully local, no key):
# LLM_GATEWAY_API_KEY=ollama
# LLM_GATEWAY_BASE_URL=http://localhost:11434/v1
# LLM_GATEWAY_MODEL=qwen2.5:14b
